<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This is the APP's own manifest. Photo analysis is entirely on-device and
	     the app's own code collects no data and defines no tracking domains — so
	     the collected-data / tracking-domain arrays are empty. The Google Mobile
	     Ads (AdMob) SDK ships its OWN bundled PrivacyInfo.xcprivacy that declares
	     the ad tracking domains and collected data types; Apple aggregates the two,
	     so we do not (and should not) duplicate that list here — a hand-copied
	     subset would just go stale. NSPrivacyTracking is true because the shipped
	     app tracks (via AdMob) and shows the ATT prompt. The App Store "App
	     Privacy" label separately declares the AdMob-collected data — see Google's
	     data-disclosure guidance. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults stores the user's default scan mode and last-scan
			     date, used only by this app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
